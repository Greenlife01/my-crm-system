# Mapbox GL JS token — enables the interactive Project Nirmatva map on the homepage.
# Without it, a static fallback list of farm sites is shown instead.
NEXT_PUBLIC_MAPBOX_TOKEN=

# EmailJS credentials — enables live form submissions (farmer registration, buyer
# enquiries, investor deck requests, career applications). Without these, forms
# simulate a successful submission so the UI flow can still be verified.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
